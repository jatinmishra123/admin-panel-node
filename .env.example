PORT=3000
JWT_SECRET=change_this_to_a_long_random_string
CUSTOMER_JWT_SECRET=change_this_to_a_different_long_random_string
MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=cruddb

# Optional: set these to store uploaded images on Cloudinary instead of local disk.
# Without them, uploads are saved to inc/assets/uploads/ (lost on redeploy on most free hosts).
# Get free credentials at https://cloudinary.com -> Dashboard
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
